          },
          "StringLike": {
            "token.actions.githubusercontent.com:sub": [
              "repo:abdullahalfarabi150-a11y@278372942/Terraform-aws-high-availability-platform@1392697685:ref:refs/heads/main",
              "repo:abdullahalfarabi150-a11y@278372942/Terraform-aws-high-availability-platform@1392697685:environment:Production"
            ]
          }
        }
      }
    ]
  }